APP_NAME="Portofolio Ikhsan"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=porto_ikhsan
DB_USERNAME=root
DB_PASSWORD=

# SMTP Configuration (PHPMailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="${APP_NAME}"
SMTP_TO_EMAIL=admin@example.com

# Session & Security
SESSION_LIFETIME=120
CSRF_SECRET=some-random-long-string
LOGIN_LIMIT_ATTEMPTS=5
LOGIN_LIMIT_TIMEOUT=900 # 15 minutes in seconds
